#!name=🌐 YouTube 字幕翻译（独立版）
#!desc=只做字幕翻译，不捆绑去广告。双语字幕（原文+译文），默认译为简体中文。翻译核心基于 LamJIson 的 youtube-dual-subs.js（已验证可跑）。
#!author=白日梦
#!icon=https://iili.io/KQ67Yxa.png

[Script]
# 双语字幕翻译（响应阶段）：拦截 timedtext，调用 Google 翻译接口，返回原文+译文
# show_only_auto_translation=false 为双语，true 为仅译文
http-response ^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?|$) script-path=https://raw.githubusercontent.com/erleizi/youtube-translator/main/youtube-dual-subs.js, requires-body=true, timeout=30, tag=YT-DualSubs-Standalone, argument=subtitle_type=Translate&show_only_auto_translation=false

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
