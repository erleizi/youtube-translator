#!name=🌐 YouTube 字幕翻译（独立版）
#!desc=只做字幕翻译，不捆绑去广告。双语字幕（原文+译文），默认简体中文。
#!author=白日梦
#!icon=https://iili.io/KQ67Yxa.png

[Argument]
show_only_auto_translation = switch, false, tag=只显示译文, desc=开=只要中文译文，关=原文+译文双语

[Script]
http-response ^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?|$) script-path=https://raw.githubusercontent.com/erleizi/youtube-translator/main/youtube-dual-subs.js, requires-body=true, timeout=30, tag=YT-DualSubs-Standalone, argument=subtitle_type=Translate&show_only_auto_translation={show_only_auto_translation}

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
